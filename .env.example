# LLM configuration for llm-param-lab (read by Quarkus at startup).
# Copy this file to `.env` (gitignored) and adjust to your setup.
# Keys map to llm.* config properties (Quarkus normalizes LLM_* -> llm.*).
#
# LLM_PROVIDER       OLLAMA | OPENAI_COMPATIBLE
# LLM_BASE_URL       base URL of the LLM server (OpenAI-compatible: include /v1)
# LLM_MODEL_NAME     model identifier sent to the server (e.g. a .gguf name)
# LLM_API_KEY        API key (uncomment + set only if your server requires one)
LLM_PROVIDER=OPENAI_COMPATIBLE
LLM_BASE_URL=http://localhost:11000/v1
LLM_MODEL_NAME=Qwen3.8-27B-UD-IQ3_S.gguf
# LLM_API_KEY=
